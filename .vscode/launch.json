{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Editor (msvc-release)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/release/bin/Batap_Editor.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (msvc-release)"
    },
    {
      "name": "Editor (msvc-debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/Batap_Editor.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (msvc-debug)"
    },
    {
      "name": "Editor (msvc-relwithdebinfo)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/relwithdebinfo/bin/Batap_Editor.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (msvc-relwithdebinfo)"
    },
    {
      "name": "TestGame (msvc-debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/Batap_TestGame.exe",
      "args": ["--project", "${workspaceFolder}/GameExemple"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build (msvc-debug)"
    },
    {
      "name": "TestGame (msvc-relwithdebinfo)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/relwithdebinfo/bin/Batap_TestGame.exe",
      "args": ["--project", "${workspaceFolder}/GameExemple"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build (msvc-relwithdebinfo)"
    },
  ]
}
